---
import DefaultLayout from "$lib/layouts/default.astro";
import Image from "astro/components/Image.astro";
---

<DefaultLayout>
  <div
    class="h-screen w-screen bg-gray-900 text-white text-center font-sans grid lg:grid-cols-4"
  >
    <div class="col-span-4 pt-20 px-4 bg-gray-900">
      <h1 class="text-7xl mb-4">PC and Rig Setup</h1>
      <div class="grid md:grid-cols-3 bg-gray-900 py-4">
        <div>
          <h2 class="text-4xl mb-2">PC Specifications</h2>
          <ul>
            <li class="list-inside list-disc">AMD Ryzen 7 7700X</li>
            <li class="list-inside list-disc">ASUS TUF Gaming X670E-PLUS WIFI</li>
            <li class="list-inside list-disc">G.SKILL Flare X5 Series 32GB (2 x 16GB) DDR5 5600</li>
            <li class="list-inside list-disc">PowerColor Hellhound Radeon RX 9070XT 16GB GDDR6</li>
            <li class="list-inside list-disc">IceGiant ProSiphon Elite CPU Cooler</li>
            <li class="list-inside list-disc">be quiet! Straight Power 11 1200W 80 PLUS Platinum PSU</li>
            <li class="list-inside list-disc">Fractal Design Pop Air (Orange) Case</li>
            <li class="list-inside list-disc">Gigabyte AORUS Gen4 1 TB SSD (Main Drive)</li>
            <li class="list-inside list-disc">Western Digital WD_Black SN850X 4 TB (Storage Drive)</li>
            <li class="list-inside list-disc">2 be quiet! Silent Wings PRO 4 140MM front intake fans</li>
            <li class="list-inside list-disc">be quiet! Silent Wings 3 120mm rear exhaust fan</li>
            <li class="list-inside list-disc">LG Internal Optical Drive</li>
          </ul>
        </div>
        <div>
          <h2 class="text-4xl mb-2">Peripherials</h2>
          <ul>
            <li class="list-inside list-disc">WASD Keyboards VP3 61-key Keyboard (Cherry MX Clears)</li>
            <li class="list-inside list-disc">Glorious Gaming Cloth Ergonomic Keyboard Wrist Rest</li>
            <li class="list-inside list-disc">Steelseries Aerox 9 Wireless Mouse (Main Mouse)</li>
            <li class="list-inside list-disc">Finalmouse Starlight-12 Phantom (FPS Mouse)</li>
            <li class="list-inside list-disc">Steelseries QcK Heavy XXL Mousepad</li>
            <li class="list-inside list-disc">Antlion Kimura Microphone Cable (2 Pin)</li>
            <li class="list-inside list-disc">TRUTHEAR x Crinacle ZERO:BLUE2 In-ear Monitor</li>
            <li class="list-inside list-disc">JCALLY JM6 Pro DAC Amp</li>
            <li class="list-inside list-disc">Focusrite 2i4 (1st Generation) Audio Interface</li>
            <li class="list-inside list-disc">Shure SM58 Microphone</li>
            <li class="list-inside list-disc">Creative Sound Blaster Katana V2X Soundbar</li>
            <li class="list-inside list-disc">AORUS FI32Q-X 32 inch 1440p 270hz Monitor</li>
            <li class="list-inside list-disc">UPLIFT V3 Standing Desk (Bamboo top 42x24 inches)</li>
          </ul>
        </div>
        <div>
          <h2 class="text-4xl mb-2">Sim Rig</h2>
          <ul>
            <li class="list-inside list-disc">Trak Racer TR80 Racing Simulator MK5</li>
            <li class="list-inside list-disc">Trak Racer GT Black Bucket Seat</li>
            <li class="list-inside list-disc">Trak Racer Cockpit Mounted Triple Monitor Mount</li>
            <li class="list-inside list-disc">Trak Racer TR One Wheel Deck</li>
            <li class="list-inside list-disc">Trak Racer TR-One Universal Direct Fit Wheel Mount </li>
            <li class="list-inside list-disc">Trak Racer Button Box / Elgato Stream Deck Mount</li>
            <li class="list-inside list-disc">Trak Racer Table Top/Desk with Swivel Mount</li>
            <li class="list-inside list-disc">3 HP X32 32 inch 1440p 165hz Monitor</li>
            <li class="list-inside list-disc">3 Belkin Mouse Pad (for table top/desk 8x9 inch each)</li>
            <li class="list-inside list-disc">Cup-Holster Cup Holder (attached to bottom of shifter mount)</li>
            <li class="list-inside list-disc">VRS DFP20 Wheel Base (with QR Connect system)</li>
            <li class="list-inside list-disc">VRS Pedals (with clutch, blue spring on brake)</li>
            <li class="list-inside list-disc">Asetek Tony Kanaan Rim (with all 6 normal paddles)</li>
            <li class="list-inside list-disc">Pineapple Grips Asetek Formula Conversion Kit</li>
            <li class="list-inside list-disc">Fanatec NASCAR Rim</li>
            <li class="list-inside list-disc">GSI Formula Pro Elite (FPE) V1</li>
            <li class="list-inside list-disc">VNM Simulation Shifter</li>
            <li class="list-inside list-disc">Elgato Stream Deck XL (iRaceIT Plugin)</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</DefaultLayout>
